# ---------------------------------------------------------------------------
# Tripzyy backend configuration
# Copy to .env and fill in. .env is gitignored; this file is the template.
# ---------------------------------------------------------------------------

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Database (local PostgreSQL, spec section 30) ---
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/tripzyy
DB_ECHO=false

# --- JWT (spec section 23) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_real_key_at_least_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Email / OTP verification (refinement R1) ---
# Set to false to let registration complete without a working mailbox.
# Tests and CI run with this off; the core app never depends on SMTP.
REQUIRE_EMAIL_VERIFICATION=true
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME=Tripzyy
SMTP_START_TLS=true

OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# --- Rate limiting (refinement R5) ---
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Business defaults ---
DEFAULT_CURRENCY=INR

# --- Optional: image hosting. Falls back to local ./uploads when unset. ---
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Optional: AI itinerary generation via Groq (E2, phase P10) ---
# Never required for core trip functionality (spec sections 2.1 and 38).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
