# ---------------------------------------------------------------------------
# Tripzyy backend configuration
# Copy to .env and fill in. .env is gitignored; this file is the template.
# ---------------------------------------------------------------------------

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# PostgreSQL is hosted (Neon). There is no local server and no createdb step.
# Take the connection string from the Neon console and swap the driver prefix
# to postgresql+asyncpg://.
#
# The pooled ("-pooler") host is correct for the application. SQLAlchemy's
# prepared-statement cache is disabled automatically for it -- see
# Settings.database_url_str -- because PgBouncer cannot carry those handles
# between transactions.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?ssl=require
DB_ECHO=false

# Optional. The test suite isolates itself in a `tripzyy_test` schema, which
# it drops and recreates on every run, and connects through Neon's *direct*
# endpoint rather than the pooler. Leave this unset to use DATABASE_URL; set
# it to point the suite at a separate instance or Neon branch.
# TEST_DATABASE_URL=

# --- JWT (spec section 23) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_real_key_at_least_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Email / OTP verification (refinement R1) ---
# Set to false to let registration complete without a working mailbox.
# Tests and CI run with this off; the core app never depends on SMTP.
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_ENABLED=true
# Option A: Google Apps Script webhook URL (recommended)
GOOGLE_APP_SCRIPT_URL=
# Option B: direct SMTP credentials (fallback)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME=Tripzyy
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_START_TLS=true
# Aliases honoured in place of SMTP_USERNAME / SMTP_PASSWORD.
EMAIL_SENDER=
EMAIL_APP_PASSWORD=

OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# --- Rate limiting (refinement R5) ---
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Business defaults ---
DEFAULT_CURRENCY=INR

# --- Optional: image hosting. Falls back to local ./uploads when unset. ---
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Optional: AI itinerary generation via Groq (E2, phase P10) ---
# Never required for core trip functionality (spec sections 2.1 and 38).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# --- Optional: Google Places (New) for destination and activity search ---
# Without it, /places/* returns 501 and the trip wizard falls back to the
# seeded catalog.
GOOGLE_PLACES_API=
