# ---------------------------------------------------------------------------
# Tripzyy frontend configuration
# Copy to .env.local and adjust. .env.local is gitignored.
#
# These are inlined into the browser bundle at build time, so nothing secret
# belongs here.
# ---------------------------------------------------------------------------

# Where the FastAPI backend is reachable. Matches the uvicorn default.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Substitute bundled sample trips, destinations and AI plans when the API
# returns nothing. Off by default, and it should stay off anywhere you need
# to trust what you are looking at: with it on, a failing backend still
# renders a complete, convincing app, which is how integration bugs go
# unnoticed. Turn it on only to demo the UI without a running backend.
NEXT_PUBLIC_DEMO_MODE=false
